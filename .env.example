# Quick Explain Configuration Template

# OpenAI API Key (Required)
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI Model Identifier (Optional, defaults to gpt-5.6-luna)
OPENAI_MODEL=gpt-5.6-luna

# UI Customizations
# Window opacity ratio from 0.0 to 1.0 (0.5 = 50% opacity)
WINDOW_OPACITY=0.5

# Window size as a percentage of screen dimensions (0.7 = 70% width and height)
WINDOW_WIDTH_RATIO=0.7
WINDOW_HEIGHT_RATIO=0.7

# Window decorations (false = floating glassmorphic pane, true = standard OS window border)
WINDOW_DECORATED=false
